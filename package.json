{
  "name": "ssh-x",
  "version": "1.0.1",
  "description": "Retro monochrome SSH, SFTP, FTP/FTPS, Telnet and local terminal client for macOS",
  "main": "src/main/main.js",
  "author": "lxstatmose",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lxstatmose/ssh-x.git"
  },
  "homepage": "https://github.com/lxstatmose/ssh-x#readme",
  "bugs": {
    "url": "https://github.com/lxstatmose/ssh-x/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "node scripts/fix-pty-perms.js",
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "start": "electron .",
    "package:dir": "npm run build && electron-builder --dir",
    "package": "npm run build && electron-builder",
    "verify": "npm run typecheck && npm run lint && npm run build"
  },
  "keywords": [
    "ssh",
    "sftp",
    "ftp",
    "ftps",
    "telnet",
    "terminal",
    "xterm",
    "electron",
    "macos",
    "retro",
    "monochrome",
    "iterm2"
  ],
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "basic-ftp": "^6.0.1",
    "node-pty": "^1.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.0.16"
  }
}
